# Environment variables template for Cloud Deployment (Render / Railway / AWS / VPS)
SERVER_PORT=8085

# Database (PostgreSQL / Supabase / Neon or default in-memory H2)
# DATABASE_URL=jdbc:postgresql://<host>:5432/<dbname>
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_db_password
# DATABASE_DRIVER=org.postgresql.Driver

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=1219522864587242

# Google Gemini Multi-Key Failover
GEMINI_API_KEY=your_gemini_primary_api_key_here
GEMINI_API_KEY_SECONDARY=your_gemini_secondary_api_key_here

# xAI Grok (Optional text fallback)
GROK_API_KEY=

# NVIDIA NIM (High-Performance LLM Failover - DeepSeek-v4-pro / Llama-3.2)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Public Domain / Hostname (for serving dynamic meal cards to WhatsApp)
APP_PUBLIC_BASE_URL=https://your-domain.com
